# ── 서버 설정 ────────────────────────────────────────────────
# HTTP 포트
PORT=3000
# 문자에 들어가는 예약 링크의 기준 URL (배포 시 공개 도메인으로 변경)
BASE_URL=http://localhost:3000
# 관리자 대시보드/관리 API 인증 토큰 (반드시 변경)
ADMIN_TOKEN=change-me-please
# SQLite DB 파일 경로
DB_PATH=./data/ars.db

# ── Twilio 설정 (선택) ───────────────────────────────────────
# 아래 3개가 모두 채워지면 실제 Twilio로 SMS를 발송합니다.
# 비워두면 "mock" 모드로 동작하여 콘솔/DB에만 문자를 기록합니다(무료 데모).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
